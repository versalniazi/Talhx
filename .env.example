# Public URL of the site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.talhx.com

# Optional: server-only webhook URL notified when an order, payment
# confirmation, enquiry or newsletter signup is submitted (e.g. Slack/Zapier/Make).
# Never prefix with NEXT_PUBLIC_ — it must not reach the browser.
NOTIFICATION_WEBHOOK_URL=

# Optional: directory for the file-based development data store.
# Replace the repository in src/lib/orders/repository.ts with a real database for production.
DATA_DIR=.data

# Persistent order storage (required on Vercel). Set automatically when you add
# "Upstash for Redis" from the Vercel Marketplace. Server-only — never prefix with NEXT_PUBLIC_.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Live chat team inbox (/admin). Comma-separated "Name:password" pairs, one per teammate.
# Use long, unique passwords. Names may not contain ":" and passwords may not contain ",".
CHAT_AGENTS=
# Long random secret (at least 32 characters) used to sign inbox logins, e.g. `openssl rand -hex 32`.
CHAT_SESSION_SECRET=
